.card
  .card-header.d-flex.align-items-center
    %span Listing Notifications

    = link_to 'New Notification', new_notification_path, class: 'btn btn-outline-secondary ms-auto'

  %table.table
    %thead
      %tr
        %th User
        %th Body
        %th Is read
        %th
    %tbody
      - @notifications.each do |notification|
        %tr
          %td= notification.user
          %td= notification.body
          %td= notification.is_read
          %td
            .btn-toolbar.float-end
              = link_to 'Show', notification, class: 'btn btn-outline-secondary btn-sm'
              = link_to 'Edit', edit_notification_path(notification), class: 'btn btn-outline-secondary ms-1 btn-sm'
              = link_to 'Destroy', notification, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger ms-1 btn-sm'