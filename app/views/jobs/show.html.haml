.row.justify-content-center
  .col-sm-8.col-lg-6
    .card
      .card-header
        %h1= @job.title
        #status_display= @job.get_status_for_display

        - if !(@job.status == "cancelled" || @job.status == "complete" || @job.status == "pending")
          = simple_form_for(@job, url: update_status_job_path(@job), method: :patch) do |f|

            .status-drop-down
              = f.label :status, "Change status"
              = f.select :status, Job::STATUSES[1...-2].map { |s| [s.to_s.humanize, s] },
                    class: "form-select";

            #custom_status_field{ style: "display: none;" }
              = f.label :custom_status, "Enter custom status"
              = f.text_field :custom_status, class: "form-control"

            #save_changes_button{ style: "display: none;" }
              = f.submit "Update Status", class: "btn btn-primary"

          #complete_job_button
            = button_to "Mark as Complete", complete_job_job_path(@job),
              method: :patch,
              class: "btn btn-danger",
              data: { turbo_confirm: 'Are you sure you want to mark this job as complete? You will no longer be able to edit it.' }

          #cancel_job_button
            = button_to "Cancel Job", cancel_job_job_path(@job),
              method: :patch,
              class: "btn btn-danger",
              data: { turbo_confirm: 'Are you sure you want to cancel this job? You will no longer be able to edit it.' }

      .card-body
        %dl.row.mb-0
          - if @user.role != "client" 
            %dt.col-md-3 Client:
            %dd.col-md-9= @job.client.email
          - if current_user.role != "operator"
            %dt.col-md-3 Operator:
            %dd.col-md-9= @job.operator.email

          .file-download-boxes
            %dt.col-md-3 Report File
            link to download report file
            %dt.col-md-3 DICOM File
            link to download dicom file

          %h4 Status history
          .status-history-box
            %ul
              - @job.status_histories.each do |history|
                %li
                  = history.formatted_history

      .card-footer.d-flex
        -if can?(:manage, Job)
          = link_to 'Edit', edit_job_path(@job), class: 'btn btn-link'
        = link_to 'Back', jobs_path, class: 'btn btn-link ms-auto'