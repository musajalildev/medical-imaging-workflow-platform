.row.justify-content-center.job-shell
  .col-sm-10.col-lg-8
    - output_file = @job.image_files.detect(&:output_file?)
    - regular_files = @job.image_files.reject(&:output_file?).sort_by(&:id)
    - file_slots = regular_files.first(2)
    - file_slots << nil while file_slots.length < 2
    .card.job-card
      .card-header
        .job-header-bar
          .job-header-main
            %span.job-form-section__eyebrow Job overview
            %h1.h3.mb-2= @job.title
            #status_display.job-status-pill= @job.get_status_for_display
            - if can?(:update_status, @job)
              .status-under-pill
                = simple_form_for(@job, url: update_status_job_path(@job), method: :patch, html: { class: 'status-inline-form' }) do |f|
                  .d-flex.flex-column.gap-2
                    %p.text-muted.mb-0.small.fw-semibold Change status
                    - current_status_label = @job.status == "custom" ? "Custom" : @job.get_status_for_display
                    - status_options = [[current_status_label, @job.status]] + @job.valid_statuses.reject { |s| s.to_s == @job.status.to_s }.map { |s| [s.to_s.humanize, s] }
                    = f.select :status, status_options, class: "form-select status-change-select"

                    #custom_status_field{ style: "display: none;" }
                      = f.label :custom_status, "Enter custom status"
                      = f.text_field :custom_status, class: "form-control form-control-sm", maxlength: 47

                    #save_changes_button{ style: "display: none;" }
                      = f.submit "Update status", class: "btn btn-primary btn-sm"

          .job-header-actions
            .job-action-row
              - if @job.draft? && can?(:submit_draft, @job)
                = button_to "Submit Job", submit_draft_job_path(@job),
                  method: :patch,
                  class: "btn btn-primary btn-sm",
                  form: { class: 'job-action-form' },
                  data: { turbo_confirm: 'Submit this job? It will enter the queue for operators.' }
              - if !@job.closed?
                - if can?(:complete_job, @job)
                  #complete_job_button
                    = button_to "Mark as Complete", complete_job_job_path(@job),
                      method: :patch,
                      class: "btn btn-success btn-sm",
                      form: { class: 'job-action-form' },
                      data: { turbo_confirm: 'Are you sure you want to mark this job as complete? You will no longer be able to edit it.' }

                - if can?(:cancel_job, @job)
                  #cancel_job_button
                    - cancel_label = @job.draft? ? "Delete Draft" : "Cancel Job"
                    - cancel_confirm = @job.draft? ? "Delete this draft? This cannot be undone." : "Are you sure you want to cancel this job? You will no longer be able to edit it."
                    = button_to cancel_label, cancel_job_job_path(@job),
                      method: :patch,
                      class: "btn btn-outline-danger btn-sm",
                      form: { class: 'job-action-form' },
                      data: { turbo_confirm: cancel_confirm }

      .card-body
        %dl.row.mb-0.job-meta-list
          - if @user.role != "client"
            %dt.col-md-3.d-flex.align-items-center
              Client

            %dd.col-md-9.d-flex.align-items-center.justify-content-between
              %span= @job.client.email

              - if can?(:unassign, @job) && @job.operator.present? && !@job.closed?
                = button_to "Drop Job", unassign_job_path(@job),
                  method: :patch,
                  class: "btn btn-outline-danger btn-sm",
                  form: { class: 'job-action-form d-inline' },
                  data: { turbo_confirm: "You are about to drop this job, meaning you will no longer be the operator for this job and it will be sent back to the unassigned jobs list. Are you sure?" }

          - if current_user.role != "operator" && @job.operator.present?
            %dt.col-md-3.d-flex.align-items-center
              Operator

            %dd.col-md-9.d-flex.align-items-center
              #display_operator_email= @job.operator.email

          - if !@job.closed? && can?(:re_assign, Job)
            - label_dialogue = @job.operator.present? ? "Select New Operator" : "Assign Operator"
            %dt.col-md-3.d-flex.align-items-center.text-nowrap
              = label_dialogue

            %dd.col-md-9
              = form_with url: re_assign_job_path(@job), method: :patch, class: "update_operator_form" do
                .d-flex.align-items-center.gap-3
                  - dropdown_label_header = @job.operator.present? ? [[@job.operator.email, @job.operator.email], ["No Operator", ""]] : [["No Operator", ""]]
                  - remaining_operator_labels = User.where(role: :operator).where.not(email: dropdown_label_header[0][1])
                  = select_tag "operator_id",
                    options_for_select(dropdown_label_header, @job.operator_id) + options_from_collection_for_select(remaining_operator_labels, :id, :email, @job.operator_id),
                    class: "form-select new-operator-dropdown",
                    id: "operator_select"

                  = submit_tag "Update Operator",
                    class: "btn btn-success btn-sm text-nowrap",
                    id: "update_operator_button"
                      
        .job-file-panel.mt-4
          %h2.h5.mb-3 Description
          - if @job.description.present?
            %p.mb-0= @job.description
          - else
            %p.text-muted.small.mb-0.fst-italic No description provided.

        .job-file-panel.mt-4
          %h2.h5.mb-3 Job input files
          .d-flex.gap-2.flex-wrap
            - file_1_url = file_slots[0]&.file_path
            - file_1_id = file_slots[0]&.drive_file_id
            - if file_1_url.present?
              - if current_user&.admin? || @job.status == "draft"
                = button_to 'Delete PDF file', remove_file_path(image_file_id: file_slots[0].id), method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: 'Delete PDF file from Google Drive?' } }
              - if file_1_id.present?
                = link_to 'Download PDF file', download_file_path(file_id: file_1_id), class: 'btn btn-primary', data: { turbo: false }
              - else
                %span.file-missing-indicator PDF not uploaded yet
            - else
              %span.file-missing-indicator PDF not uploaded yet

            - file_2_url = file_slots[1]&.file_path
            - file_2_id = file_slots[1]&.drive_file_id
            - if file_2_url.present?
              - if current_user&.admin? || @job.status == "draft"
                = button_to 'Delete DICOM file', remove_file_path(image_file_id: file_slots[1].id), method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: 'Delete DICOM file from Google Drive?' } }
              - if file_2_id.present?
                = link_to 'Download DICOM file(s)', download_file_path(file_id: file_2_id, image_file_id: file_slots[1].id), class: 'btn btn-primary', data: { turbo: false }
              - else
                %span.file-missing-indicator DICOM not uploaded yet
            - else
              %span.file-missing-indicator DICOM not uploaded yet

        .job-file-panel.mt-4
          %h2.h5.mb-3 Output file

          - if can?(:upload_output, @job) && !@job.complete? && !@job.cancelled?
            = form_with url: upload_output_job_path(@job), method: :post, local: true, multipart: true, class: 'job-output-form d-flex flex-column gap-2 mb-3' do
              %input.form-control{ type: 'file', name: 'output_file', accept: '.pdf,application/pdf' }
              %button.btn.btn-outline-primary.align-self-start{ type: 'submit' } Upload report file

          .d-flex.gap-2.flex-wrap
            - output_url = output_file&.file_path
            - output_id = output_file&.drive_file_id
            - if output_url.present?
              - if current_user&.admin?
                = button_to 'Delete Report file', remove_file_path(image_file_id: output_file.id), method: :delete, class: 'btn btn-outline-danger', form: { data: { turbo_confirm: 'Delete Report file from Google Drive?' } }
              - if output_id.present?
                = link_to 'Download Report file', download_file_path(file_id: output_id), class: 'btn btn-primary', data: { turbo: false }
              - else
                %span.file-missing-indicator Report not uploaded yet
            - else
              %span.file-missing-indicator Report not uploaded yet

        .job-file-panel.mt-4
          %h4.mb-3 Status history
          .status-history-box
            %ul.list-unstyled.mb-0
              - if @job.status_histories.any?
                - @job.status_histories.each do |history|
                  %li.status-history-item
                    = history.formatted_history
              %li.status-history-item
                - job_type = @job.status == "draft" ? "Draft" : "Job"
                = job_type + " created at " + @job.created_at.strftime("%Y/%m/%d, at %H:%M") + " by " + @job.client.email

      .card-footer.d-flex.align-items-center.gap-2.flex-wrap
        - if can?(:manage, Job) || (@job.draft? && can?(:edit, @job))
          = link_to 'Edit', edit_job_path(@job), class: 'btn btn-link'
        = link_to 'Back', jobs_path(tab: @tab), class: 'btn btn-link ms-auto'