<h1>Create Job</h1>

<%= form_with model: @job, local: true, multipart: true do |f| %>
  <div>
    <%= f.label :title %>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :pdf %>
    <%= f.file_field :pdf %>
  </div>

  <div>
    <%= f.label :dicom %>
    <%= f.file_field :dicom %>
  </div>

  <%= f.submit "Create Job" %>
<% end %>