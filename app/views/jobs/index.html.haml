.card
  .card-header.d-flex.align-items-center
    %span Jobs
    %span.badge.bg-secondary.ms-2= @total_count

  .card-body
    = form_with url: jobs_path, method: :get, local: true do |f|
      .d-flex.gap-2.align-items-center
        = f.select :status,
            Job::STATUSES.map { |s| [s.to_s.humanize, s] },
            { include_blank: 'All Statuses', selected: params[:status] },
            class: 'form-select'
        = f.text_field :search, value: params[:search], placeholder: 'Search...', class: 'form-control'
        = f.submit 'Search', class: 'btn btn-outline-secondary'
        - if params[:status].present? || params[:search].present?
          = link_to 'Clear', jobs_path, class: 'btn btn-link'

    %p.text-muted.mt-2.mb-0
      = "Showing #{@jobs.count} of #{@total_count}"

  %table.table.mb-0
    %thead
      %tr
        %th Client
        %th Job Submitted
        %th Operator
        %th Status
        %th
        %th
    %tbody
      - @jobs.each do |job|
        %tr
          %td= [job.client.givenname, job.client.sn].compact.join(' ').presence || job.client.username || job.client.email
          %td= job.created_at.strftime('%d %b, %Y ')
          %td= job.operator ? ([job.operator.givenname, job.operator.sn].compact.join(' ').presence || job.operator.username || job.operator.email) : '-'
          %td
            - if can?(:manage, job)
              = form_with url: job_path(job), method: :patch, local: true do |f|
                = f.select 'job[status]',
                    Job::STATUSES.map { |s| [s.to_s.humanize, s] },
                    { selected: job.status },
                    class: 'form-select form-select-sm', onchange: 'this.form.submit()'
            - else
              = job.status.to_s.humanize
          %td= link_to 'Details', job
          -if can?(:manage, Job)
            %td= link_to 'Manage', edit_job_path(job)
