-# frozen_string_literal: true
= simple_form_for(@job) do |f|
  .card-body
    = f.association :client, wrapper_html: { class: 'mb-3' }
    = f.association :operator, wrapper_html: { class: 'mb-3' }
    = f.input :status, wrapper_html: { class: 'mb-3' }
    = f.input :title, wrapper_html: { class: 'mb-3' }
    = f.input :description, wrapper_html: { class: 'mb-3' }
    = f.input :created_at, wrapper_html: { class: 'mb-3' } # fixed method error
    

  .card-footer.d-flex
    %button.btn.btn-primary{ type: 'submit' }
      Save
    = link_to 'Back', jobs_path, class: 'btn btn-link ms-auto'
