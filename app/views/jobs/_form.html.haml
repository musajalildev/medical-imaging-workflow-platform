-# frozen_string_literal: true
= simple_form_for(@job) do |f|
  .card-body
    = f.association :client, wrapper_html: { class: 'mb-3' }
    = f.association :operator, wrapper_html: { class: 'mb-3' }
    = f.input :status, wrapper_html: { class: 'mb-3' }
    = f.input :title, wrapper_html: { class: 'mb-3' }
    = f.input :description, wrapper_html: { class: 'mb-3' }

    %hr
    %h2.h5.mb-3 Upload File

    #drive-upload
      .mb-3
        %label.form-label{ for: 'upload-file-input' } File
        %input#upload-file-input.form-control{ type: 'file' }

      .d-flex.align-items-center.gap-3.mb-3
        %button#upload-button.btn.btn-outline-primary{ type: 'button' } Upload To Drive
        %span#upload-status.text-muted Ready

      .mb-2
        %label.form-label{ for: 'upload-progress' } Progress
        %progress#upload-progress.form-control{ value: '0', max: '100' } 0%

      #upload-progress-text.small.text-muted 0%

    %input#uploaded-file-id{ type: 'hidden', name: 'uploaded_file_id' }
    %input#uploaded-file-type{ type: 'hidden', name: 'uploaded_file_type', value: 'google_drive_file_id' }

  .card-footer.d-flex
    %button.btn.btn-primary{ type: 'submit' }
      Save
    = link_to 'Back', jobs_path, class: 'btn btn-link ms-auto'
