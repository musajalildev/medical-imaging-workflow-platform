-# frozen_string_literal: true
- submit_label = @job.persisted? ? 'Update Job' : 'Create Job'
- submit_note = @job.persisted? ? 'Update the job details and attached inputs.' : 'Add the job details and upload the required input files.'
= simple_form_for(@job) do |f|
  - if @job.errors.any?
    .alert.alert-danger.mx-3.mt-3
      %ul.mb-0
        - @job.errors.full_messages.each do |msg|
          %li= msg
  #client-side-errors.alert.alert-danger.mx-3.mt-3{ style: 'display:none;' }
    %ul.mb-0
  .card-body.job-form
    .job-form-section
      .job-form-section__header
        %span.job-form-section__eyebrow Job details
        %h2.job-form-section__title.mb-1 Basic information
        %p.text-muted.small.mb-0= submit_note
      .job-form-grid
        = f.input :title, wrapper_html: { class: 'mb-0' }, input_html: { class: 'form-control-lg' }
        = f.input :description, as: :text, wrapper_html: { class: 'mb-0 job-description-wrapper' }, input_html: { rows: 5, class: 'job-description-textarea' }

    .job-form-section
      .job-form-section__header
        %span.job-form-section__eyebrow Input files
        %h2.job-form-section__title.mb-1 Upload source files
        %p.text-muted.small.mb-0 Selected files upload automatically before the job is saved.

      #drive-upload.job-upload-panel
        .job-upload-grid
          .job-upload-field
            %label.form-label.fw-semibold{ for: 'upload-file-input-1' } PDF file
            %input#upload-file-input-1.form-control{ type: 'file', accept: '.pdf,application/pdf' }
            %p.form-text.mb-0 Attach the document or instructions for the job.

          .job-upload-field
            %label.form-label.fw-semibold{ for: 'upload-file-input-2' } DICOM file
            %input#upload-file-input-2.form-control{ type: 'file', accept: '.dcm,application/dicom' }
            %p.form-text.mb-0 Attach the imaging dataset used as input.

        .job-upload-status
          .d-flex.justify-content-between.align-items-center.flex-wrap.gap-2.mb-2
            %label.form-label.fw-semibold.mb-0{ for: 'upload-progress' } Upload progress
            %span#upload-status.text-muted.small Ready
          %progress#upload-progress.upload-progress-styled{ value: '0', max: '100' } 0%
          .upload-progress-track
            #upload-progress-bar.upload-progress-bar{ style: 'width: 0%' }
          #upload-progress-text.small.text-muted.mt-2 0%

    %input#uploaded-files-json{ type: 'hidden', name: 'uploaded_files_json', value: '[]' }

  .card-footer.d-flex.align-items-center.gap-2.flex-wrap
    %button.btn.btn-primary.px-4{ type: 'submit' }
      = submit_label
    = link_to 'Back', jobs_path, class: 'btn btn-link ms-auto'
