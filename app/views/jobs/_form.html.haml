-# frozen_string_literal: true
= simple_form_for(@job) do |f|
  .card-body
    = f.association :operator, wrapper_html: { class: 'mb-3' }
    - if @job.new_record?
      = f.label :status
      = f.select :status, Job::STATUSES.map { |s| [s.to_s.humanize, s] },
             {},
             class: "form-select";

      #custom_status_field{ style: "display: none;" }
        = f.label :custom_status, "Enter custom status"
        = f.text_field :custom_status, class: "form-control"

    = f.input :title, wrapper_html: { class: 'mb-3' }
    = f.input :description, wrapper_html: { class: 'mb-3' }

    %hr
    %h2.h5.mb-3 Upload Files
    %p.text-muted.small.mb-3 Selected files are uploaded automatically when you click Save.

    #drive-upload
      .mb-3
        %label.form-label{ for: 'upload-file-input-1' } PDF file
        %input#upload-file-input-1.form-control{ type: 'file', accept: '.pdf,application/pdf' }

      .mb-3
        %label.form-label{ for: 'upload-file-input-2' } DICOM file
        %input#upload-file-input-2.form-control{ type: 'file', accept: '.dcm,application/dicom' }

      .mb-3
        %span#upload-status.text-muted Ready

      .mb-2
        %label.form-label{ for: 'upload-progress' } Progress
        %progress#upload-progress.form-control{ value: '0', max: '100' } 0%

      #upload-progress-text.small.text-muted 0%

    %input#uploaded-files-json{ type: 'hidden', name: 'uploaded_files_json', value: '[]' }

  .card-footer.d-flex
    %button.btn.btn-primary{ type: 'submit' }
      Save
    = link_to 'Back', jobs_path, class: 'btn btn-link ms-auto'
