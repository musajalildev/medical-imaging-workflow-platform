%table.table
  %thead
    %tr
      %th Username
      %th Role
      %th Email
      %th
  %tbody
    - @users.each do |user|
      %tr
        %td= user.username
        %td= user.role
        %td= user.email
        %td= link_to 'Details', user_path(user), class: 'btn btn-outline-secondary btn-sm'