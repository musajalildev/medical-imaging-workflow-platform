!!!
%html{ lang: 'en-GB' }
  %head
    %title Project

    %meta{ :'http-equiv' => "content-type", content: "text/html; charset=utf-8" }
    %meta{ :'http-equiv' => 'X-UA-Compatible', content: 'IE=edge' }
    %meta{ name: "viewport", content: "width=device-width, initial-scale=1.0, shrink-to-fit=no" }

    - if content_for(:description)
      %meta{ content: content_for(:description), name: 'description' }

    %title= ["Project", content_for(:title)].compact.join(' - ')

    = csrf_meta_tags
    = csp_meta_tag

    = capybara_lockstep if defined?(Capybara::Lockstep)

    = stylesheet_pack_tag 'styles', media: 'all', data: { turbo_track: 'reload' }
    = javascript_pack_tag 'application', data: { turbo_track: 'reload' }

  %body.app-shell
    %header.navbar.navbar-expand-lg.app-header
      .container-fluid.app-container
        = link_to '#', class: 'navbar-brand d-flex align-items-center gap-2 fw-semibold' do
          = image_pack_tag 'images/logo.png', height: 40
          %span Project
        %button.navbar-toggler{ type: :button, data: { bs_toggle: :collapse, bs_target: '#navbar-content' }, aria: { controls: 'navbar-content', expanded: 'false', label: 'Toggle navigation' } }
          %span.navbar-toggler-icon
        #navbar-content.navbar-collapse.collapse
          %nav.navbar-nav.align-items-center.gap-2
            = link_to root_path, class: "nav-link px-3 #{'active' if current_page?(root_path)}" do
              %i.bi-house-fill
              Home
            = link_to jobs_path, class: "nav-link px-3 #{'active' if current_page?(jobs_path)}" do
              %i.bi-kanban-fill
              Jobs
            - if user_signed_in? && current_user&.client?
              = link_to 'Create Job', new_job_path, class: 'btn btn-primary btn-sm navbar-create-job ms-lg-2'
          - if user_signed_in?
            .d-flex.align-items-center.gap-2.ms-auto.flex-wrap
              %span.text-muted.small.fw-medium
                = "Signed in as #{current_user.username}"
              - if Rails.env.development?
                = button_to 'Switch user', dev_session_path, method: :delete, class: 'btn btn-outline-secondary btn-sm'
              - else
                = button_to 'Sign out', destroy_user_session_path, method: :delete, class: 'btn btn-outline-secondary btn-sm'

    - if flash.present?
      .container-fluid.app-container.flash-messages.py-2
        - flash.each do |message_type, message|
          - next unless message_type == 'alert' || message_type == 'notice'
          .alert.shadow-sm.border-0{ class: "alert-#{ message_type == 'notice' ? 'success' : 'danger' }" }= message

    %main.app-main.py-3.py-lg-4
      .container-fluid.app-container
        = yield

    %footer.app-footer
      .container-fluid.app-container
        .d-flex.p-3.align-items-center.justify-content-between.flex-wrap.gap-2
          %span.text-muted.small Project workspace
          %span.text-muted.small Software Hut
