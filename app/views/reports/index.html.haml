.card
  .card-header.d-flex.align-items-center
    %span Listing Reports

    = link_to 'New Report', new_report_path, class: 'btn btn-outline-secondary ms-auto'

  %table.table
    %thead
      %tr
        %th Job
        %th File path
        %th
    %tbody
      - @reports.each do |report|
        %tr
          %td= report.job
          %td= report.file_path
          %td
            .btn-toolbar.float-end
              = link_to 'Show', report, class: 'btn btn-outline-secondary btn-sm'
              = link_to 'Edit', edit_report_path(report), class: 'btn btn-outline-secondary ms-1 btn-sm'
              = link_to 'Destroy', report, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger ms-1 btn-sm'