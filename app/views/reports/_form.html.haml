-# frozen_string_literal: true
= simple_form_for(@report) do |f|
  .card-body
    = f.association :job, wrapper_html: { class: 'mb-3' }
    = f.input :file_path, wrapper_html: { class: 'mb-3' }

  .card-footer.d-flex
    %button.btn.btn-primary{ type: 'submit' }
      Save
    = link_to 'Back', reports_path, class: 'btn btn-link ms-auto'
