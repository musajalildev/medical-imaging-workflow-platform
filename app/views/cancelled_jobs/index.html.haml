.card
  .card-header.d-flex.align-items-center
    %span Listing Cancelled Jobs

    = link_to 'New Cancelled job', new_cancelled_job_path, class: 'btn btn-outline-secondary ms-auto'

  %table.table
    %thead
      %tr
        %th Job
        %th Cancel reason
        %th
    %tbody
      - @cancelled_jobs.each do |cancelled_job|
        %tr
          %td= cancelled_job.job
          %td= cancelled_job.cancel_reason
          %td
            .btn-toolbar.float-end
              = link_to 'Show', cancelled_job, class: 'btn btn-outline-secondary btn-sm'
              = link_to 'Edit', edit_cancelled_job_path(cancelled_job), class: 'btn btn-outline-secondary ms-1 btn-sm'
              = link_to 'Destroy', cancelled_job, method: :delete, data: { confirm: 'Are you sure?' }, class: 'btn btn-outline-danger ms-1 btn-sm'